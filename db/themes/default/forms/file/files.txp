<div class="file">
    <a href="<txp:file_download_link />"><strong><txp:evaluate><txp:file_download_name title /><txp:else /><txp:file_download_name /></txp:evaluate></strong></a>
    <span class="meta"><txp:file_download_size /> &middot; <txp:file_download_downloads /> <txp:text item="download_count" /></span>
    <txp:evaluate test="file_download_description"><p><txp:file_download_description /></p></txp:evaluate>
</div>
