<div class="txp-layout">
<div class="txp-layout-1col"><h1 class="txp-heading"><%= @page_title %></h1></div>
<div class="txp-layout-4col-alt">
  <div class="txp-box">
    <h2><%= gTxt("your_account") %></h2>
    <p><strong><%= current_user.display_name %></strong> (<%= current_user.name %>)<br><%= gTxt(current_user.group == "none" ? "privs_none" : current_user.group) %></p>
    <% if has_privs?("admin.edit.own") %>
    <%= form_tag admin_url, method: :post, class: "txp-edit-inline" do %>
      <h3><%= gTxt("change_password") %></h3>
      <%= input_label("current-pass", password_field_tag(:current_pass, nil, id: "current-pass", autocomplete: "current-password", required: true), "current_password") %>
      <%= input_label("new-pass", password_field_tag(:new_pass, nil, id: "new-pass", autocomplete: "new-password", minlength: 6, required: true, class: "txp-maskable"), "new_password") %>
      <%= event_hidden("admin", "change_pass") %>
      <p><%= submit_tag gTxt("change_password"), name: nil %></p>
    <% end %>
    <%= form_tag admin_url, method: :post do %>
      <h3><%= gTxt("change_email") %></h3>
      <%= input_label("new-email", email_field_tag(:new_email, current_user.email, id: "new-email", required: true), "email") %>
      <%= event_hidden("admin", "change_email") %>
      <p><%= submit_tag gTxt("change_email"), name: nil %></p>
    <% end %>
    <% end %>
  </div>
</div>
<div class="txp-layout-4col-3span">
<% if @users %>
  <div class="txp-control-panel">
    <% if has_privs?("admin.edit") %><%= txp_button_link("add_new_author", admin_url(event: "admin", step: "author_edit"), klass: "txp-button publish") %><% end %>
  </div>
  <%= form_tag admin_url, method: :get, class: "txp-search" do %>
    <%= event_hidden("admin", "author_list") %>
    <%= search_field_tag :crit, params[:crit], placeholder: gTxt("search"), class: "txp-search-input", "aria-label": gTxt("search") %>
    <%= submit_tag gTxt("search"), name: nil %>
  <% end %>
  <%= form_tag admin_url, method: :post, class: "multi_edit_form", id: "users_form" do %>
  <div class="txp-listtables">
  <table class="txp-list">
  <thead><tr>
    <%= select_all_head %>
    <%= column_head("login_name", "name", @state, "admin", step_name: "author_list", klass: "login-name") %>
    <%= column_head("real_name", "RealName", @state, "admin", step_name: "author_list", klass: "name") %>
    <%= column_head("email", "email", @state, "admin", step_name: "author_list") %>
    <%= column_head("role", "privs", @state, "admin", step_name: "author_list") %>
    <%= column_head("last_login", "last_login", @state, "admin", step_name: "author_list", klass: "date") %>
    <%= plain_head("articles", "articles") %>
  </tr></thead>
  <tbody>
  <% @users.each do |u| %>
  <tr>
    <td class="txp-list-col-multi-edit"><%= check_box_tag("selected[]", u.name, false, class: "checkbox", id: nil) unless u == current_user %></td>
    <td class="txp-list-col-login-name"><%= has_privs?("admin.edit") ? link_to(u.name, admin_url(event: "admin", step: "author_edit", user_id: u.user_id)) : u.name %></td>
    <td class="txp-list-col-name"><%= u.RealName %></td>
    <td class="txp-list-col-email"><%= mail_to u.email %></td>
    <td class="txp-list-col-privs"><%= gTxt(u.group == "none" ? "privs_none" : u.group.to_s) %></td>
    <td class="txp-list-col-last_login date"><%= u.last_access ? format_admin_date(u.last_access) : gTxt("never") %></td>
    <td class="txp-list-col-articles"><%= link_to @article_counts[u.name].to_i, admin_url(event: "list", search_method: "author", crit: u.name) %></td>
  </tr>
  <% end %>
  </tbody>
  </table>
  </div>
  <% if has_privs?("admin.edit") %>
  <%= multi_edit({
    "changeprivilege" => { label: gTxt("changeprivilege"), html: txp_select(:privs, group_choices, 4, id: "multi-privs") },
    "resetpassword" => "reset_password",
    "delete" => { label: gTxt("delete"), html: content_tag(:label, gTxt("assign_assets_to"), for: "multi-assign") + txp_select(:assign_assets, user_choices, current_user.name, id: "multi-assign") }
  }, "admin", "admin_multi_edit") %>
  <% end %>
  <% end %>
  <div class="txp-navigation"><%= pageby_form("admin", @state, step_name: "author_list") %><%= txp_pager(@state, "admin", step_name: "author_list") %></div>
<% end %>
</div>
</div>
