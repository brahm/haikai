<%= form_tag admin_url, method: :post, class: "txp-login", id: "login_form" do %>
<h1 id="txp-<%= @activate ? 'set' : 'change' %>-password-heading"><%= @page_title %></h1>
<%= input_label("new_password", password_field_tag(:p_password, nil, id: "new_password", autocomplete: "new-password", autofocus: true, required: true, minlength: 6, class: "txp-maskable") +
  content_tag(:div, check_box_tag(:unmask, 1, false, id: "show_password", class: "checkbox") + " " + label_tag(:show_password, gTxt("show_password")), class: "show-password"), "new_password", klass: @activate ? "set-password" : "change-password") %>
<p><%= submit_tag gTxt("password_confirm_button"), class: "publish", name: nil %></p>
<% unless @activate %><p class="login-return"><%= link_to gTxt("back_to_login"), admin_url(lang: lang_ui) %></p><% end %>
<%= hidden_field_tag :hash, @hash, id: nil %>
<%= hidden_field_tag :lang, lang_ui, id: nil %>
<%= hidden_field_tag(@activate ? :p_set : :p_alter, 1, id: nil) %>
<% end %>
